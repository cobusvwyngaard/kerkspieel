{
  // Config for Cloudflare's git-connected Worker deploy (Workers & Pages
  // dashboard). The dashboard's "Worker" import flow reads this from the
  // repo root and runs `wrangler deploy`; it needs the newer [assets]-style
  // config, not the classic Pages `pages_build_output_dir` key.
  "name": "kerkspieel",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/public"
  }
}
