# Raw extracts are NEVER committed. The survey files carry free-text
# comments that identify individual ministers and congregations, and the
# ABR ministers files carry names, dates of birth and South African ID
# numbers. Ignore the whole tree rather than a file glob, so a new
# subdirectory cannot quietly become committable.
data/raw/

node_modules/
dist/
.wrangler/
__pycache__/
*.pyc

# pdftotext caches, regenerated by scripts/build_codebook.py
data/codebook/*.txt

# The congregation-level intermediate. One row per congregation per wave,
# so a named congregation's answers are readable from it. It never reaches
# the published site -- scripts/build_aggregates.py reduces it to the ring,
# synod and national counts in web/public/data/aggregates.json, and only
# that file is committed and deployed.
data/build/

node_modules/
package-lock.json
package.json
