# Raw survey extracts are NOT committed by default.
# They contain free-text comment fields that may identify individual
# ministers and congregations (POPIA). Decide on a redaction policy
# before putting them under version control or shipping them to a CDN.
data/raw/*.xlsx
data/raw/*.xls

node_modules/
dist/
.wrangler/
__pycache__/
*.pyc

# pdftotext caches, regenerated by scripts/build_codebook.py
data/codebook/*.txt

# The congregation-level intermediate. One row per congregation per wave,
# so a named congregation's answers are readable from it. It never reaches
# the published site -- scripts/build_aggregates.py reduces it to the ring,
# synod and national counts in web/public/data/aggregates.json, and only
# that file is committed and deployed.
data/build/

node_modules/
package-lock.json
package.json
