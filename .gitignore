# Raw survey extracts are NOT committed by default.
# They contain free-text comment fields that may identify individual
# ministers and congregations (POPIA). Decide on a redaction policy
# before putting them under version control or shipping them to a CDN.
data/raw/*.xlsx
data/raw/*.xls

node_modules/
dist/
.wrangler/
__pycache__/
*.pyc

# pdftotext caches, regenerated by scripts/build_codebook.py
data/codebook/*.txt

# Built browser dataset. Regenerate with scripts/build_dataset.py.
# It holds one row per congregation per wave, so although the dashboard
# only ever displays aggregates, the file itself exposes a named
# congregation's answers. Decide whether to ship per-congregation rows or
# pre-aggregated ones before deploying anywhere public.
web/public/data/*.json
node_modules/
package-lock.json
package.json
